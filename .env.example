# ==============================================================================
# AI-Powered SaaS Platform - Environment Configuration
# Copy this file to .env and provide your actual values.
# ==============================================================================

# Database Configuration (PostgreSQL / NeonDB)
# Neon pooled connection string (used by app runtime):
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"
# Neon direct connection string (used by Prisma migrations):
DIRECT_URL="postgresql://neondb_owner:password@ep-sample.region.neon.tech/neondb?sslmode=require"

# Authentication Secrets (REQUIRED)
# Must be a secure random secret of at least 32 characters for signing JWT session tokens.
# The application will fail to start/authenticate if this is missing or shorter than 32 characters.
# Generate via: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-secure-random-secret-key-at-least-32-characters-long"
# Base URL of application (for redirects and password reset links)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Provider Configuration
# Supported providers: "openai", "groq", "gemini"
AI_PROVIDER="openai"
# API Key for chosen provider (e.g. OpenAI key, Groq key, or Gemini key)
AI_API_KEY="sk-your-ai-api-key"
# Model identifier (e.g. "gpt-4o-mini", "llama-3.3-70b-versatile", "gemini-2.0-flash")
AI_MODEL="gpt-4o-mini"

# Optional: Dedicated provider keys if configuring multiple fallback providers
OPENAI_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Email Delivery Configuration (Resend)
# Required for sending password reset emails
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
# Verified sender address (e.g. "ApexAI <noreply@yourdomain.com>" or "ApexAI <onboarding@resend.dev>" for testing)
EMAIL_FROM="ApexAI <onboarding@resend.dev>"

# Distributed Rate Limiting (Upstash Redis)
# Required for shared rate limiting across serverless instances in production
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# Application Settings
NODE_ENV="development"
